<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <RootNamespace>PiDbg.DebugAdapter</RootNamespace>
    <AssemblyName>pidbg-adapter</AssemblyName>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\PiDbg.Core\PiDbg.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled daemon binary (copied by PackageDaemon target below) -->
    <EmbeddedResource Include="Resources\meadow-daemon" />
    <EmbeddedResource Condition="Exists('Resources\vsdbg-linux-arm64.tar.gz')" Include="Resources\vsdbg-linux-arm64.tar.gz" />
    <EmbeddedResource Condition="Exists('Resources\vsdbg-linux-arm64.tar.gz.sha256')" Include="Resources\vsdbg-linux-arm64.tar.gz.sha256" />
  </ItemGroup>

  <Target Name="PackageDaemon" BeforeTargets="PrepareForBuild">
    <Message Importance="high" Text="Packaging Meadow.Daemon for bundling..." />
    <MSBuild Projects="..\Meadow.Daemon\Meadow.Daemon.csproj" Targets="Publish" Properties="Configuration=$(Configuration);RuntimeIdentifier=linux-arm64;PublishSingleFile=true;SelfContained=true" />
    <Copy SourceFiles="..\Meadow.Daemon\bin\$(Configuration)\net9.0\linux-arm64\publish\meadow-daemon" DestinationFiles="Resources\meadow-daemon" SkipUnchangedFiles="true" />
  </Target>

</Project>
