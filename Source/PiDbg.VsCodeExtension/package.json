{
  "name": "pidbg",
  "displayName": "PiDbg — Raspberry Pi .NET Debugger",
  "description": "Debug .NET applications on Raspberry Pi ARM64 from VS Code",
  "version": "0.9.9",
  "publisher": "wildernessLabs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WildernessLabs/pidbg.git",
    "directory": "Source/PiDbg.VsCodeExtension"
  },
  "bugs": {
    "url": "https://github.com/WildernessLabs/pidbg/issues"
  },
  "homepage": "https://github.com/WildernessLabs/pidbg/tree/main/Source/PiDbg.VsCodeExtension#readme",
  "keywords": ["raspberry pi", "debugger", "remote debugging", "dotnet", "arm64", "meadow"],
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Debuggers"],
  "activationEvents": ["onDebug"],
  "main": "./out/extension.js",
  "contributes": {
    "debuggers": [
      {
        "type": "pidbg",
        "label": "Raspberry Pi (.NET)",
        "languages": ["csharp"],
        "program": "./bin/pidbg-adapter.exe",
        "runtime": "",
        "configurationAttributes": {
          "launch": {
            "required": ["host", "username", "appName", "projectPath"],
            "properties": {
              "host":           { "type": "string",  "description": "Pi hostname or IP address" },
              "port":           { "type": "number",  "description": "SSH port (default 22)", "default": 22 },
              "username":       { "type": "string",  "description": "SSH username" },
              "privateKeyPath": { "type": "string",  "description": "Path to SSH private key file" },
              "password":       { "type": "string",  "description": "SSH password (prefer key auth)" },
              "appName":        { "type": "string",  "description": "Application name (used for deployment path)" },
              "projectPath":    { "type": "string",  "description": "Absolute path to .csproj file" },
              "rootFolder":     { "type": "string",  "description": "Root folder on Pi (default ~/meadow)", "default": "~/meadow" },
              "args":           { "type": "array",   "items": { "type": "string" }, "description": "Arguments passed to the application" },
              "deployRuntimeIfNecessary": { "type": "boolean", "description": "Automatically install the required .NET runtime on the device if missing (default false)", "default": false },
              "stopAtEntry":    { "type": "boolean", "description": "Start the app suspended and break before any app code runs, to allow stepping through startup (default false)", "default": false }
            }
          }
        },
        "configurationSnippets": [
          {
            "label": "PiDbg: Debug on Raspberry Pi",
            "description": "Debug a .NET application on a Raspberry Pi",
            "body": {
              "type":           "pidbg",
              "request":        "launch",
              "name":           "Debug on Raspberry Pi",
              "host":           "${1:raspberrypi.local}",
              "username":       "${2:pi}",
              "privateKeyPath": "${userHome}/.ssh/pidbg_rsa",
              "appName":        "${workspaceFolderBasename}",
              "projectPath":    "${workspaceFolder}/${workspaceFolderBasename}.csproj"
            }
          }
        ]
      }
    ],
    "breakpoints": [
      { "language": "csharp" }
    ],
    "commands": [
      {
        "command": "pidbg.connectToDevice",
        "title":   "PiDbg: Connect to Device",
        "category": "PiDbg"
      },
      {
        "command": "pidbg.showOutput",
        "title":   "PiDbg: Show Output",
        "category": "PiDbg"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch":   "tsc -watch -p ./",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node":   "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce":  "^2.29.0",
    "typescript":    "^5.4.0"
  },
  "dependencies": {
    "@vscode/debugadapter": "^1.65.0"
  }
}
