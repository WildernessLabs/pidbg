<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net472</TargetFrameworks>
    <RootNamespace>PiDbg</RootNamespace>
    <AssemblyName>PiDbg.Core</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meadow.Daemon.Contracts\Meadow.Daemon.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SSH.NET" />
    <PackageReference Include="Grpc.Core" />
    <PackageReference Include="Grpc.Net.Client" Condition="'$(TargetFramework)' == 'net9.0'" />
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <!-- System.Text.Json is in-box for net9.0; the package backfills net472 via netstandard2.0 -->
    <PackageReference Include="System.Text.Json" Condition="'$(TargetFramework)' == 'net472'" />
  </ItemGroup>

  <!-- System.Net.Http is not auto-referenced in SDK-style projects targeting net472 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Reference Include="System.Net.Http" />
  </ItemGroup>

  <!-- NetGrpcChannelFactory uses Grpc.Net.Client which is unavailable on net472 -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <Compile Remove="Infrastructure\NetGrpcChannelFactory.cs" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Provisioning\Resources\detect.sh" />
    <EmbeddedResource Include="Provisioning\Resources\meadow-daemon.service.template" />
    <EmbeddedResource Include="Provisioning\Resources\version-manifest.json" />
  </ItemGroup>

</Project>
