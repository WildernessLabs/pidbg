<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Meadow.Daemon</RootNamespace>
    <AssemblyName>meadow-daemon</AssemblyName>
    <OutputType>Exe</OutputType>

    <!-- Self-contained single-file for linux-arm64 -->
    <RuntimeIdentifier>linux-arm64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <TrimmerRootDescriptor>TrimmerRoots.xml</TrimmerRootDescriptor>

    <!-- Deterministic build -->
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Meadow.Daemon.Contracts\Meadow.Daemon.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Generic Host + Kestrel -->
    <PackageReference Include="Microsoft.AspNetCore.App" />

    <!-- systemd integration: sd_notify, UseSystemd() -->
    <PackageReference Include="Microsoft.Extensions.Hosting.Systemd" Version="10.*" />

    <!-- gRPC server -->
    <PackageReference Include="Grpc.AspNetCore" Version="2.*" />
    <PackageReference Include="Grpc.HealthCheck" Version="2.*" />

    <!-- POSIX syscalls (symlink, rename, kill/SIGTERM) -->
    <PackageReference Include="Mono.Posix.NETStandard" Version="1.*" />

    <!-- MQTT for OTA -->
    <PackageReference Include="MQTTnet" Version="4.*" />

    <!-- JSON serialization -->
    <PackageReference Include="System.Text.Json" Version="10.*" />
  </ItemGroup>

</Project>
