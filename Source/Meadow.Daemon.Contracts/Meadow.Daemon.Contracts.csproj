<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net9.0;net472</TargetFrameworks>
    <OutputType>Library</OutputType>
    <Nullable>enable</Nullable>
    <RootNamespace>Meadow.Daemon.Contracts</RootNamespace>
    <AssemblyName>Meadow.Daemon.Contracts</AssemblyName>
    <Description>gRPC contracts (proto + generated stubs) for Meadow.Daemon v1</Description>
  </PropertyGroup>

  <!-- ImplicitUsings is a .NET 6+ SDK feature; not applicable to net472 -->
  <PropertyGroup Condition="'$(TargetFramework)' != 'net472'">
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Google.Protobuf" />
    <PackageReference Include="Grpc.Tools" PrivateAssets="All" />
  </ItemGroup>

  <!-- Managed HTTP/2 client for daemon (net9.0) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
    <PackageReference Include="Grpc.Net.Client" />
  </ItemGroup>

  <!-- C-core client for VSIX (net472) -->
  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <PackageReference Include="Grpc.Core" />
  </ItemGroup>

  <ItemGroup>
    <!-- Server stubs: included in daemon; client stubs: included in VSIX and client lib -->
    <Protobuf Include="proto\common.proto"         ProtoRoot="proto" GrpcServices="Both" />
    <Protobuf Include="proto\deployment.proto"     ProtoRoot="proto" GrpcServices="Both" />
    <Protobuf Include="proto\process.proto"        ProtoRoot="proto" GrpcServices="Both" />
    <Protobuf Include="proto\session.proto"        ProtoRoot="proto" GrpcServices="Both" />
    <Protobuf Include="proto\meadow_daemon.proto"  ProtoRoot="proto" GrpcServices="Both" />
  </ItemGroup>

</Project>

